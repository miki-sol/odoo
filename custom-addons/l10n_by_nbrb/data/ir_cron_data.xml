<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_l10n_by_nbrb_update" model="ir.cron">
        <field name="name">НБ РБ: ежедневная загрузка курсов</field>
        <field name="model_id" ref="model_l10n_by_nbrb_service"/>
        <field name="state">code</field>
        <field name="code">model.cron_update_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now().replace(hour=9, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
