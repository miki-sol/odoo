<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_by_nbrb_history_wizard_form" model="ir.ui.view">
        <field name="name">l10n.by.nbrb.history.wizard.form</field>
        <field name="model">l10n.by.nbrb.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Загрузка курсов за период">
                <group>
                    <group string="Параметры">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="currency_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Результат" invisible="loaded_days == 0 and error_days == 0 and weekend_days == 0">
                        <field name="loaded_days"/>
                        <field name="error_days"/>
                        <field name="weekend_days"/>
                    </group>
                </group>
                <footer>
                    <button name="action_load" type="object" string="Загрузить" class="oe_highlight"/>
                    <button name="action_open_logs" type="object" string="Открыть журнал"
                            invisible="loaded_days == 0 and error_days == 0"/>
                    <button special="cancel" string="Закрыть"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_by_nbrb_history_wizard" model="ir.actions.act_window">
        <field name="name">Загрузить за период</field>
        <field name="res_model">l10n.by.nbrb.history.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
