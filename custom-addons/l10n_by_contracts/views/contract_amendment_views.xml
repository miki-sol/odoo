<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_amendment_form" model="ir.ui.view">
        <field name="name">contract.amendment.form</field>
        <field name="model">contract.amendment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="subject"/>
                            <field name="date_signed"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="attachment" filename="attachment_filename"/>
                            <field name="attachment_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_contract_amendment_list" model="ir.ui.view">
        <field name="name">contract.amendment.list</field>
        <field name="model">contract.amendment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="contract_id"/>
                <field name="subject"/>
                <field name="date_signed"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_contract_amendment" model="ir.actions.act_window">
        <field name="name">Допсоглашения</field>
        <field name="res_model">contract.amendment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
