<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_contract" model="ir.ui.view">
        <field name="name">sale.order.form.contract</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_id"
                       options="{'no_create': True}"
                       context="{'default_side': 'sale', 'default_partner_id': partner_id}"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_list_contract" model="ir.ui.view">
        <field name="name">sale.order.list.contract</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
