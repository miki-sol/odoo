<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_contracts" model="ir.module.category">
        <field name="name">Договоры</field>
        <field name="sequence">22</field>
    </record>

    <record id="privilege_contracts" model="res.groups.privilege">
        <field name="name">Договоры</field>
        <field name="category_id" ref="module_category_contracts"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_contract_user" model="res.groups">
        <field name="name">Пользователь: договоры</field>
        <field name="privilege_id" ref="privilege_contracts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_contract_manager" model="res.groups">
        <field name="name">Менеджер договоров</field>
        <field name="privilege_id" ref="privilege_contracts"/>
        <field name="implied_ids" eval="[(4, ref('group_contract_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_contract_company" model="ir.rule">
        <field name="name">Договоры: правило мультикомпании</field>
        <field name="model_id" ref="model_contract_contract"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
    </record>
</odoo>
