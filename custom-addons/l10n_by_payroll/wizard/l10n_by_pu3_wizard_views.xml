<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_by_pu3_wizard_form" model="ir.ui.view">
        <field name="name">l10n.by.pu3.wizard.form</field>
        <field name="model">l10n.by.pu3.wizard</field>
        <field name="arch" type="xml">
            <form string="Формирование ПУ-3">
                <group>
                    <field name="year" readonly="file_data"/>
                    <field name="quarter" readonly="file_data"/>
                </group>
                <field name="note" readonly="1" nolabel="1"/>
                <group invisible="not file_data">
                    <field name="employee_count" readonly="1"/>
                    <field name="file_name" readonly="1"/>
                    <field name="file_data" filename="file_name" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Сформировать XML"
                            class="oe_highlight" invisible="file_data"/>
                    <button special="cancel" string="Закрыть"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_by_pu3_wizard" model="ir.actions.act_window">
        <field name="name">ПУ-3 (квартальная)</field>
        <field name="res_model">l10n.by.pu3.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
