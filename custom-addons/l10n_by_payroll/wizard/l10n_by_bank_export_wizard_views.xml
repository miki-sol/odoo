<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_by_bank_export_wizard_form" model="ir.ui.view">
        <field name="name">l10n.by.bank.export.wizard.form</field>
        <field name="model">l10n.by.bank.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Зарплатная ведомость в банк">
                <group>
                    <field name="period_id" readonly="file_data"/>
                    <field name="bank_format" readonly="file_data"/>
                </group>
                <field name="note" readonly="1" nolabel="1"/>
                <group invisible="not file_data">
                    <field name="file_name" readonly="1"/>
                    <field name="file_data" filename="file_name" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Сформировать"
                            class="oe_highlight" invisible="file_data"/>
                    <button special="cancel" string="Закрыть"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
