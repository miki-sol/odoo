<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_sku" model="ir.ui.view">
        <field name="name">product.template.form.sku</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="sku"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_list_view_sku" model="ir.ui.view">
        <field name="name">product.template.list.sku</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="sku" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_sku" model="ir.ui.view">
        <field name="name">product.template.search.sku</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="sku"/>
            </xpath>
        </field>
    </record>
</odoo>
