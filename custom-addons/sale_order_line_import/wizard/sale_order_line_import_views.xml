<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_line_import_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.line.import.wizard.form</field>
        <field name="model">sale.order.line.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Sale Order Lines">
                <group invisible="report">
                    <field name="order_id" readonly="1"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="has_header"/>
                </group>
                <group invisible="not report">
                    <field name="report" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_import"
                            string="Import"
                            type="object"
                            class="btn-primary"
                            invisible="report"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_order_line_import_wizard" model="ir.actions.act_window">
        <field name="name">Импорт позиций</field>
        <field name="res_model">sale.order.line.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
